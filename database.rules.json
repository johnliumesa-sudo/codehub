            ".validate": "newData.isString() && newData.val().length === 16"
          },
          "ct": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4096"
          },
          "$other": {
            ".validate": false
          }
        },
        "ghToken": {
          ".validate": "newData.hasChildren(['iv', 'ct'])",
          "iv": {
            ".validate": "newData.isString() && newData.val().length === 16"
          },
          "ct": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4096"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
