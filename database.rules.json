              },
              "createdBy": {
                ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
              },
              "createdAt": {
                ".validate": "newData.isNumber()"
              },
              "updatedAt": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "updates": {
            "$fid": {
              ".write": "!newData.exists() && root.child('servers').child($sid).child('members').child(auth.uid).exists()",
              "$pushId": {
                ".write": "root.child('servers').child($sid).child('members').child(auth.uid).exists() && (!newData.exists() || (!data.exists() && newData.child('uid').val() === auth.uid))",
                ".validate": "newData.hasChildren(['iv', 'ct', 'uid', 'ts'])",
                "iv": {
                  ".validate": "newData.isString() && newData.val().length === 16"
                },
                "ct": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1400000"
                },
                "uid": {
                  ".validate": "newData.isString()"
                },
                "ts": {
                  ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "snapshots": {
            "$fid": {
              ".write": "root.child('servers').child($sid).child('members').child(auth.uid).exists()",
              ".validate": "newData.hasChildren(['iv', 'ct', 'upTo', 'ts'])",
              "iv": {
                ".validate": "newData.isString() && newData.val().length === 16"
              },
              "ct": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2800000"
              },
              "upTo": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
              },
              "ts": {
                ".validate": "newData.isNumber() && newData.val() <= now + 60000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "awareness": {
            "$fid": {
              ".write": "!newData.exists() && root.child('servers').child($sid).child('members').child(auth.uid).exists()",
              "$uid": {
                ".write": "$uid === auth.uid && (root.child('servers').child($sid).child('members').child(auth.uid).exists() || !newData.exists())",
                ".validate": "newData.hasChildren(['iv', 'ct', 'ts'])",
                "iv": {
                  ".validate": "newData.isString() && newData.val().length === 16"
                },
                "ct": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16384"
                },
                "ts": {
                  ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
