            ".write": "($uid === auth.uid && !root.child('servers').child($sid).child('meta').exists() && newData.child('role').val() === 'owner' && newData.parent().parent().child('meta').child('ownerId').val() === auth.uid) || ($uid === auth.uid && !data.exists() && newData.child('role').val() === 'member' && !root.child('servers').child($sid).child('bans').child(auth.uid).exists() && newData.child('invite').isString() && root.child('servers').child($sid).child('invites').child(newData.child('invite').val()).exists() && (root.child('servers').child($sid).child('invites').child(newData.child('invite').val()).child('expiresAt').val() === 0 || root.child('servers').child($sid).child('invites').child(newData.child('invite').val()).child('expiresAt').val() > now) && (root.child('servers').child($sid).child('invites').child(newData.child('invite').val()).child('maxUses').val() === 0 || root.child('servers').child($sid).child('invites').child(newData.child('invite').val()).child('uses').val() < root.child('servers').child($sid).child('invites').child(newData.child('invite').val()).child('maxUses').val())) && newData.parent().parent().child('invites').child(newData.child('invite').val()).child('uses').val() === root.child('servers').child($sid).child('invites').child(newData.child('invite').val()).child('uses').val() + 1 || ($uid === auth.uid && !newData.exists() && data.child('role').val() !== 'owner') || (root.child('servers').child($sid).child('members').child(auth.uid).child('role').val() === 'owner' && $uid !== auth.uid && data.exists() && (!newData.exists() || newData.child('role').val() === 'admin' || newData.child('role').val() === 'member')) || (root.child('servers').child($sid).child('members').child(auth.uid).child('role').val() === 'admin' && $uid !== auth.uid && data.child('role').val() === 'member' && (!newData.exists() || newData.child('role').val() === 'member'))",
