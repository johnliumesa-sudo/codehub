            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "expiresAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "maxUses": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "uses": {
              ".write": "data.isNumber() && newData.val() === data.val() + 1 && !root.child('servers').child($sid).child('members').child(auth.uid).exists() && newData.parent().parent().parent().child('members').child(auth.uid).child('invite').val() === $iid",
