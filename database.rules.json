        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userServers": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "$sid": {
          ".write": "$uid === auth.uid || (!newData.exists() && (root.child('servers').child($sid).child('members').child(auth.uid).child('role').val() === 'owner' || root.child('servers').child($sid).child('members').child(auth.uid).child('role').val() === 'admin'))",
          ".validate": "newData.hasChildren(['joinedAt'])",
          "joinedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "servers": {
      "$sid": {
        ".read": "root.child('servers').child($sid).child('members').child(auth.uid).exists()",
        ".write": "(!newData.exists() && data.child('meta').child('ownerId').val() === auth.uid) || (!data.exists() && newData.child('meta').child('ownerId').val() === auth.uid && newData.child('members').child(auth.uid).child('role').val() === 'owner' && newData.child('keys').child(auth.uid).exists())",
        "meta": {
          ".write": "(!data.exists() && newData.child('ownerId').val() === auth.uid) || (data.exists() && newData.exists() && (root.child('servers').child($sid).child('members').child(auth.uid).child('role').val() === 'owner' || root.child('servers').child($sid).child('members').child(auth.uid).child('role').val() === 'admin') && newData.child('ownerId').val() === data.child('ownerId').val())",
