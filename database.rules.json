              },
              "y": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
              },
              "$other": {
                ".validate": false
              }
            },
            "iv": {
              ".validate": "newData.isString() && newData.val().length === 16"
            },
            "ct": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 256"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "invites": {
          "$iid": {
            ".read": "auth != null",
            ".write": "(root.child('servers').child($sid).child('members').child(auth.uid).child('role').val() === 'owner' || root.child('servers').child($sid).child('members').child(auth.uid).child('role').val() === 'admin') && (!newData.exists() || data.exists() || newData.child('createdBy').val() === auth.uid)",
